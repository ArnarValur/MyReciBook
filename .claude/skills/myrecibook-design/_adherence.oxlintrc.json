{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/data-display/**",
              "components/editor/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icon/**",
              "components/navigation/**",
              "components/surfaces/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Plus Jakarta Sans|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Inter, Plus Jakarta Sans, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBackButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:onClick|color|style|key|ref|className|style|children)$/]",
        "message": "<AppBackButton> doesn't accept that prop. Declared props: onClick, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|outlined|text|danger)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'outlined' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChipRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:categories|active|onSelect|allLabel|style|key|ref|className|style|children)$/]",
        "message": "<CategoryChipRow> doesn't accept that prop. Declared props: categories, active, onSelect, allLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|body|verb|onCancel|onConfirm|style|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: open, title, body, verb, onCancel, onConfirm, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverPickerField'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|height|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CoverPickerField> doesn't accept that prop. Declared props: src, height, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DashedInfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<DashedInfoCard> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DurationField'] > JSXAttribute > JSXIdentifier[name!=/^(?:initialMinutes|onChanged|hint|style|key|ref|className|style|children)$/]",
        "message": "<DurationField> doesn't accept that prop. Declared props: initialMinutes, onChanged, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: label, icon, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|fill|iconColor|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GlassCircle> doesn't accept that prop. Declared props: icon, fill, iconColor, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onTab|onFab|style|key|ref|className|style|children)$/]",
        "message": "<GlassNavBar> doesn't accept that prop. Declared props: items, active, onTab, onFab, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GlassPill> doesn't accept that prop. Declared props: icon, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientFab'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GradientFab> doesn't accept that prop. Declared props: icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|fill|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, fill, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IngredientRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|checked|onToggle|trailing|staple|last|style|key|ref|className|style|children)$/]",
        "message": "<IngredientRow> doesn't accept that prop. Declared props: text, checked, onToggle, trailing, staple, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|withSteam|style|key|ref|className|style|children)$/]",
        "message": "<LogoMark> doesn't accept that prop. Declared props: size, color, withSteam, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<MetaChip> doesn't accept that prop. Declared props: icon, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|brand|quantity|kcal|image|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductRow> doesn't accept that prop. Declared props: name, brand, quantity, kcal, image, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecipeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|cover|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RecipeCard> doesn't accept that prop. Declared props: title, meta, cover, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecipeCover'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|title|style|key|ref|className|style|children)$/]",
        "message": "<RecipeCover> doesn't accept that prop. Declared props: src, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SearchBar> doesn't accept that prop. Declared props: placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|trailing|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|showCheck|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, showCheck, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServingsStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|style|key|ref|className|style|children)$/]",
        "message": "<ServingsStepper> doesn't accept that prop. Declared props: value, onChange, min, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Snackbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Snackbar> doesn't accept that prop. Declared props: message, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: icon, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripedPlaceholder'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|height|style|key|ref|className|style|children)$/]",
        "message": "<StripedPlaceholder> doesn't accept that prop. Declared props: icon, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TokenCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|selected|shadow|color|borderColor|children|style|key|ref|className|style|children)$/]",
        "message": "<TokenCard> doesn't accept that prop. Declared props: padding, radius, selected, shadow, color, borderColor, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
